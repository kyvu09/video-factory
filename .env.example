# ============================================================
# CẤU HÌNH MẪU BIẾN MÔI TRƯỜNG CHO VIDEO FACTORY
# Sao chép file này thành `.env` (file `.env` đã được .gitignore bảo vệ)
# hoặc nhập trực tiếp API Key ngay trên giao diện `gui.py` (lưu vào `.ai_config.json`).
# ============================================================

# Khóa API Google Gemini (lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# (Tùy chọn) HuggingFace Token để tăng tốc tải trọng số VieNeu-TTS ở lần chạy đầu tiên
# HF_TOKEN=your_optional_hf_token_here
